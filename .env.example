# ====================================================================
# ALINEA LAUNDRY - TEMPLATE ENVIRONMENT VARIABLES (.env)
# ====================================================================
# Petunjuk: Salin file ini menjadi '.env' di folder 'server' dan sesuaikan nilainya.
# Jangan pernah membagikan file '.env' asli yang berisi data sensitif!

# --- KONFIGURASI SERVER ---
NODE_ENV=development
PORT=5000

# --- KONFIGURASI DATABASE (POSTGRESQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=alinea_laundry

# --- KEAMANAN & AUTENTIKASI ---
# Generate secret key yang kuat (misal dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here

# Kunci rahasia untuk mengakses detail lengkap /api/health (opsional, bisa dikosongkan di dev)
# Gunakan header: x-health-key: <nilai ini> saat request ke /api/health
HEALTH_CHECK_KEY=your_health_check_secret_key_here

# --- CROSS-ORIGIN RESOURCE SHARING (CORS) ---
# Pisahkan dengan tanda koma jika ada beberapa origin
CORS_ORIGIN=http://localhost:3000

# --- GOOGLE OAUTH CLIENT ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
