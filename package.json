{
  "name": "alinea-laundry-root",
  "version": "1.0.0",
  "description": "Fullstack Alinea Laundry",
  "scripts": {
    "client-install": "cd client && npm install",
    "server-install": "cd server && npm install",
    "install-all": "npm run client-install && npm run server-install",
    "postinstall": "npm run install-all",
    "client-build": "cd client && npm run build",
    "build": "npm run client-build",
    "server": "cd server && npx nodemon index.js",
    "client": "cd client && npm start",
    "dev": "npx concurrently \"npm run server\" \"npm run client\"",
    "start": "npm run client-build && npm run server"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.3.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^3.13.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-format": "^1.0.4",
    "@supabase/supabase-js": "^2.50.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
