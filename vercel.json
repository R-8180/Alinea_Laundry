{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/(static|favicon\\.ico|manifest\\.json|robots\\.txt|images|qris\\.jpg|qris\\.png)(/.*)?$",
      "dest": "client/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html"
    }
  ]
}
